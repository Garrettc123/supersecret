#!/usr/bin/env python3
"""
SuperSecret CLI – full implementation
"""
from __future__ import annotations
import sys
import os
import getpass
import time
from pathlib import Path

# Force the installed lib path
sys.path.insert(0, str(Path.home() / ".local" / "lib" / "supersecret"))

from vault import store, load, delete, list_names, load_config, save_config, STORE
from clipboard import copy, clear


def die(msg: str, code: int = 1):
    print(msg, file=sys.stderr)
    sys.exit(code)


def cmd_set(args: list[str]):
    if not args:
        die("Usage: secret set <name>")
    name = args[0]
    print(f"Enter secret for '{name}' (input invisible):")
    secret = getpass.getpass("→ ")
    if not secret:
        die("Empty secret aborted.")
    confirm = getpass.getpass("Confirm: ")
    if secret != confirm:
        die("Mismatch. Nothing stored.")
    master = getpass.getpass("Master password: ")
    store(name, secret, master)
    secret = confirm = "0" * 64
    print(f"✓ Stored encrypted as '{name}'")


def cmd_get(args: list[str]):
    if not args:
        die("Usage: secret get <name>")
    name = args[0]
    master = getpass.getpass("Master password: ")
    try:
        plaintext = load(name, master)
    except FileNotFoundError:
        die(f"No secret named '{name}'")
    except Exception:
        die("Wrong master password or corrupted data.")

    cfg = load_config()
    ttl = int(cfg.get("clipboard_ttl", 30))

    if copy(plaintext):
        print(f"✓ '{name}' → clipboard (clears in {ttl}s)")
        plaintext = "0" * len(plaintext)
        time.sleep(ttl)
        clear()
        print("Clipboard cleared.")
    else:
        print("No clipboard tool found. Secret:")
        print(plaintext)
        plaintext = "0" * len(plaintext)


def cmd_list(_args: list[str]):
    names = list_names()
    if not names:
        print("Vault empty.")
    else:
        print("Vaulted secrets:")
        for n in names:
            print(f"  • {n}")


def cmd_rm(args: list[str]):
    if not args:
        die("Usage: secret rm <name>")
    name = args[0]
    if delete(name):
        print(f"✓ Deleted '{name}'")
    else:
        die(f"No secret named '{name}'")


def cmd_auto(args: list[str]):
    if not args or args[0] not in ("on", "off"):
        die("Usage: secret auto on|off")
    cfg = load_config()
    cfg["auto"] = args[0] == "on"
    save_config(cfg)
    print(f"✓ Auto mode {'enabled' if cfg['auto'] else 'disabled'}")


def cmd_status(_args: list[str]):
    cfg = load_config()
    names = list_names()
    print("SuperSecret Status")
    print("──────────────────")
    print(f"Vaulted secrets : {len(names)}")
    print(f"Auto mode       : {'ON' if cfg.get('auto') else 'OFF'}")
    print(f"Clipboard TTL   : {cfg.get('clipboard_ttl', 30)}s")
    agent_pid = STORE / "agent.pid"
    if agent_pid.exists():
        try:
            pid = int(agent_pid.read_text().strip())
            os.kill(pid, 0)
            print(f"Agent           : running (pid {pid})")
        except (OSError, ValueError):
            print("Agent           : not running")
            agent_pid.unlink(missing_ok=True)
    else:
        print("Agent           : not running")
    print(f"Vault path      : {STORE}")


def cmd_watch(_args: list[str]):
    print("Starting SuperSecret agent... (Ctrl+C to stop)")
    pid_file = STORE / "agent.pid"
    pid_file.write_text(str(os.getpid()))
    try:
        while True:
            time.sleep(30)
    except KeyboardInterrupt:
        pid_file.unlink(missing_ok=True)
        print("\nAgent stopped.")


def main():
    if len(sys.argv) < 2:
        print("""SuperSecret — full implementation

Commands:
  secret set <name>       Store secret (invisible input)
  secret get <name>       Retrieve → ghost clipboard
  secret list             List vaulted names
  secret rm <name>        Delete
  secret auto on|off      Zero-touch mode
  secret watch            Run background agent
  secret status           Live status
""")
        sys.exit(0)

    cmd = sys.argv[1]
    args = sys.argv[2:]

    dispatch = {
        "set": cmd_set,
        "get": cmd_get,
        "list": cmd_list,
        "rm": cmd_rm,
        "auto": cmd_auto,
        "status": cmd_status,
        "watch": cmd_watch,
    }

    if cmd not in dispatch:
        die(f"Unknown command: {cmd}")
    dispatch[cmd](args)


if __name__ == "__main__":
    main()
