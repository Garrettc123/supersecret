#!/usr/bin/env python3
"""
SuperSecret — stupid-simple secret input + unprecedented automation
"""
import sys
import os
import getpass
import subprocess
import time
import hashlib
import json
from pathlib import Path
from typing import Optional

STORE = Path.home() / ".secrets"
STORE.mkdir(mode=0o700, exist_ok=True)
CONFIG = STORE / "config.json"
AGENT_PID = STORE / "agent.pid"

def encrypt(data: bytes, password: str) -> bytes:
    key = hashlib.scrypt(
        password.encode(),
        salt=b"supersecret-v1",
        n=2**14,
        r=8,
        p=1,
        dklen=32
    )
    stream = b""
    counter = 0
    while len(stream) < len(data):
        stream += hashlib.sha256(key + counter.to_bytes(8, "big")).digest()
        counter += 1
    return bytes(a ^ b for a, b in zip(data, stream[:len(data)]))

def decrypt(data: bytes, password: str) -> bytes:
    return encrypt(data, password)  # XOR is symmetric

def load_config() -> dict:
    if CONFIG.exists():
        return json.loads(CONFIG.read_text())
    return {"auto": False, "clipboard_ttl": 30}

def save_config(cfg: dict):
    CONFIG.write_text(json.dumps(cfg, indent=2))
    CONFIG.chmod(0o600)

def copy_to_clipboard(text: str) -> bool:
    for cmd in (
        ["xclip", "-selection", "clipboard"],
        ["xsel", "--clipboard", "--input"],
        ["pbcopy"],
        ["wl-copy"],
    ):
        try:
            subprocess.run(cmd, input=text.encode(), check=True, capture_output=True)
            return True
        except (FileNotFoundError, subprocess.CalledProcessError):
            continue
    return False

def clear_clipboard():
    for cmd in (
        ["xclip", "-selection", "clipboard"],
        ["xsel", "--clipboard", "--input"],
        ["pbcopy"],
        ["wl-copy"],
    ):
        try:
            subprocess.run(cmd, input=b"", check=True, capture_output=True)
            return
        except (FileNotFoundError, subprocess.CalledProcessError):
            continue

def cmd_set(name: str):
    print(f"Enter secret for '{name}' (input is invisible):")
    secret = getpass.getpass("→ ")
    if not secret:
        print("Empty secret, aborted.")
        sys.exit(1)
    confirm = getpass.getpass("Confirm: ")
    if secret != confirm:
        print("Mismatch. Nothing stored.")
        sys.exit(1)

    master = getpass.getpass("Master password (used to encrypt): ")
    encrypted = encrypt(secret.encode(), master)
    path = STORE / f"{name}.sec"
    path.write_bytes(encrypted)
    path.chmod(0o600)
    print(f"✓ Stored encrypted as '{name}'")

def cmd_get(name: str):
    path = STORE / f"{name}.sec"
    if not path.exists():
        print(f"No secret named '{name}'")
        sys.exit(1)

    master = getpass.getpass("Master password: ")
    try:
        plaintext = decrypt(path.read_bytes(), master).decode()
    except Exception:
        print("Wrong master password or corrupted data.")
        sys.exit(1)

    cfg = load_config()
    ttl = cfg.get("clipboard_ttl", 30)

    if copy_to_clipboard(plaintext):
        print(f"✓ '{name}' copied to clipboard. Will clear in {ttl}s.")
        # Zero the string as best we can
        plaintext = "0" * len(plaintext)
        time.sleep(ttl)
        clear_clipboard()
        print("Clipboard cleared.")
    else:
        print("No clipboard tool found. Secret is:")
        print(plaintext)
        plaintext = "0" * len(plaintext)

def cmd_list():
    names = sorted(p.stem for p in STORE.glob("*.sec"))
    if not names:
        print("No secrets stored.")
    else:
        print("Stored secrets:")
        for n in names:
            print(f"  • {n}")

def cmd_rm(name: str):
    path = STORE / f"{name}.sec"
    if path.exists():
        path.unlink()
        print(f"✓ Deleted '{name}'")
    else:
        print(f"No secret named '{name}'")

def cmd_auto(state: str):
    cfg = load_config()
    if state == "on":
        cfg["auto"] = True
        save_config(cfg)
        print("✓ Auto mode enabled. High-entropy strings will be offered for vaulting.")
    elif state == "off":
        cfg["auto"] = False
        save_config(cfg)
        print("✓ Auto mode disabled.")
    else:
        print("Usage: secret auto on|off")

def cmd_status():
    cfg = load_config()
    names = list(STORE.glob("*.sec"))
    print("SuperSecret Status")
    print("──────────────────")
    print(f"Vaulted secrets : {len(names)}")
    print(f"Auto mode       : {'ON' if cfg.get('auto') else 'OFF'}")
    print(f"Clipboard TTL   : {cfg.get('clipboard_ttl', 30)}s")
    if AGENT_PID.exists():
        try:
            pid = int(AGENT_PID.read_text().strip())
            os.kill(pid, 0)
            print(f"Agent           : running (pid {pid})")
        except (OSError, ValueError):
            print("Agent           : not running")
            AGENT_PID.unlink(missing_ok=True)
    else:
        print("Agent           : not running")

def cmd_watch():
    print("Starting background agent... (Ctrl+C to stop)")
    # Minimal agent placeholder – full version would hook shell
    AGENT_PID.write_text(str(os.getpid()))
    try:
        while True:
            time.sleep(60)
    except KeyboardInterrupt:
        AGENT_PID.unlink(missing_ok=True)
        print("\nAgent stopped.")

def main():
    if len(sys.argv) < 2:
        print("""SuperSecret — stupid-simple secrets

Usage:
  secret set <name>       Store a secret
  secret get <name>       Copy secret to clipboard (auto-clears)
  secret list             List vaulted secrets
  secret rm <name>        Delete a secret
  secret auto on|off      Toggle zero-touch mode
  secret watch            Start background agent
  secret status           Show status
""")
        sys.exit(1)

    cmd = sys.argv[1]

    if cmd == "set":
        if len(sys.argv) < 3:
            print("Need a name: secret set <name>")
            sys.exit(1)
        cmd_set(sys.argv[2])
    elif cmd == "get":
        if len(sys.argv) < 3:
            print("Need a name: secret get <name>")
            sys.exit(1)
        cmd_get(sys.argv[2])
    elif cmd == "list":
        cmd_list()
    elif cmd == "rm":
        if len(sys.argv) < 3:
            print("Need a name: secret rm <name>")
            sys.exit(1)
        cmd_rm(sys.argv[2])
    elif cmd == "auto":
        if len(sys.argv) < 3:
            print("Usage: secret auto on|off")
            sys.exit(1)
        cmd_auto(sys.argv[2])
    elif cmd == "status":
        cmd_status()
    elif cmd == "watch":
        cmd_watch()
    else:
        print(f"Unknown command: {cmd}")
        sys.exit(1)

if __name__ == "__main__":
    main()
